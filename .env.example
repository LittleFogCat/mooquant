# mookquant 环境配置模板
# 复制此文件为 .env 并填入实际值

# Python 解释器路径（需包含 numpy 等依赖）
MOOKQUANT_PYTHON=D:/software/python/python.exe

# xtquant 包路径（从券商获取，解压后的目录）
XTQUANT_PATH=C:/path/to/xtquant

# miniQMT 行情连接
QMT_HOST=127.0.0.1
QMT_PORT=58610

# miniQMT 交易连接（userdata 目录路径，如 D:\qmt\userdata_mini）
QMT_PATH=D:/qmt/userdata_mini

# 交易账号
QMT_ACCOUNT_ID=你的资金账号
QMT_ACCOUNT_TYPE=STOCK
