{
  "name": "mookquant",
  "version": "0.1.0",
  "description": "苹果设计风格的量化投资桌面应用，基于 Electron + MVVM 分层架构",
  "main": "main.js",
  "author": "mookquant",
  "license": "MIT",
  "scripts": {
    "start": "vite build && chcp 65001 >nul & electron .",
    "dev": "vite build && chcp 65001 >nul & electron . --enable-logging",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "bridge:install": "cd bridge && pip install -r requirements.txt",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "vite:watch": "vite build --watch"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.mookquant.desktop",
    "productName": "mookquant",
    "files": [
      "main.js",
      "preload.js",
      "config/**",
      "main/**",
      "dist/**",
      "renderer/splash.html",
      "renderer/css/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "flatpickr": "^4.6.13",
    "pinyin-pro": "^3.28.1"
  }
}